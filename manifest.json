{
  "manifest_version": 3,
  "name": "Twitch Live Translator",
  "version": "0.1.0",
  "description": "Traduz mensagens novas do chat da Twitch localmente quando as APIs nativas do navegador estiverem disponíveis.",
  "action": {
    "default_title": "Twitch Live Translator",
    "default_popup": "src/popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://twitch.tv/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/utils.js",
        "src/shared/settings.js",
        "src/services/browserTranslator.js",
        "src/services/translationService.js",
        "src/content/translationQueue.js",
        "src/content/twitchChat.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
